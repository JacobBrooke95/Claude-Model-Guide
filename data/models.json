  "_about": "Source of truth for every Claude release the site and the forecast know about. Edit here, then run `python3 scripts/build-site-data.py`. It rewrites the modelData and pricing blocks in claude-models.html and the whole of forecast/data/anthropic_releases.csv. See data/README.md.",
  "_fields": {"id": "release_id in the CSV; board-checks.json refers to releases by it", "date": "first day the model is usable by the public (restricted models: the announcement day)", "family": "mythos | fable | opus | sonnet | haiku, or legacy (CSV only; never shown on the site)", "model": "full name; the CSV model column, and the label on the site unless site_label is set", "version / generation / access / colaunch_group / note": "CSV columns, read by the forecast engine", "price_in / price_out": "USD per million tokens at launch (null where there was no list price)", "price_long": "optional long-context rate {input, output, over}, shown in the pricing tooltip", "url": "announcement page: source_url in the CSV, the link on the family card", "site_label": "optional: the name the site shows when it differs from model", "site_flag": "optional: notReleased (preview never generally released). access=restricted sets restricted by itself"},
